{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#17352d",
    "primaryBorderColor": "#6f8c83",
    "lineColor": "#61716c",
    "edgeLabelBackground": "#ffffff"
  },
  "flowchart": {
    "curve": "basis",
    "nodeSpacing": 38,
    "rankSpacing": 65,
    "padding": 18,
    "wrappingWidth": 320,
    "minNodeWidth": 220
  },
  "securityLevel": "strict",
  "htmlLabels": false,
  "look": "classic"
}
